{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peda-store-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-03-20",

  "vars": {
    "CORS_ORIGIN": "*",
    "FIREBASE_PROJECT_ID": "srishambhushaandsons"
  }

  // Secrets are NOT stored in this file.
  // Add them from Cloudflare Dashboard:
  //
  // FIREBASE_API_KEY
  // FIREBASE_ADMIN_EMAIL
  // FIREBASE_ADMIN_PASSWORD
  //
  // RAZORPAY_KEY_ID
  // RAZORPAY_KEY_SECRET
  // RAZORPAY_WEBHOOK_SECRET
  //
  // SHIPROCKET_EMAIL
  // SHIPROCKET_PASSWORD
  //
  // BREVO_API_KEY
}
